# BloomStreak works in LocalStorage-only mode without Supabase environment variables.
# To enable optional Magic Link sign-in and cloud sync, copy this file to .env.local.
# Get browser-safe values from Supabase Dashboard > Project Settings > API.
# The URL and one key variable below must be provided together for Supabase mode.

# Optional for LocalStorage mode; required for Supabase mode.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Optional for LocalStorage mode; required for Supabase mode.
# Prefer the browser-safe publishable key. Older projects may label it as an anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Security requirements:
# - Only use a browser-safe publishable/anon key in NEXT_PUBLIC_* variables.
# - Never place a service_role key in any NEXT_PUBLIC_* variable.
# - Never add a database password, service_role key, JWT secret, access token, or refresh token to this file.
